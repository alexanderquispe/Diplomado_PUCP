# Datos: van en el repo, para que los notebooks corran apenas se clona, sin
# pasos previos. Solo se excluye lo que deja scripts/fetch_data.py al
# descargarlos de Hugging Face: su caché y sus reglas de LFS.
data/.cache/
data/.gitattributes

# Entornos
.venv/
venv/
__pycache__/
*.py[cod]
.python-version

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# Secretos
.env
.env.*
!.env.example

# Sistema
.DS_Store
Thumbs.db

# Salidas locales
*.html
!sessions/**/assets/*.html
output/
_output/

# Salidas regenerables de los notebooks (se crean al correr las celdas)
sessions/03-pandas/dengue_limpio.csv
sessions/03-pandas/reporte_dengue.xlsx
sessions/05-apis-e-ia/reclamos_clasificados.csv

# Python Intermedio (sesiones 07-raster a 12): lo que se descarga o se genera
# al correr los notebooks. Un modelo afinado pesa mas de 1 GB y GitHub rechaza
# cualquier archivo de mas de 100 MB.
sessions/07-raster/**/*.tif
sessions/07-raster/**/*.shp
sessions/07-raster/**/*.dbf
sessions/07-raster/**/*.shx
sessions/07-raster/**/*.prj
sessions/07-raster/**/*.cpg
sessions/07-raster/**/*.sbn
sessions/07-raster/**/*.sbx
sessions/07-raster/lab/climate_risk_by_district.csv
sessions/09-huggingface-finetuning/**/ModernBERT-*/
sessions/**/checkpoint-*/
sessions/**/chroma_storage/
sessions/**/chroma_clinical/
sessions/**/*.wav

# Temporales de Excel (aparecen al abrir un .xlsx)
~$*
